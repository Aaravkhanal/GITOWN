# Docker Compose development settings. These are example-only local credentials.
POSTGRES_PASSWORD=change-this-local-development-password
GITOWN_ALLOW_SIGNUP=true

# For running the API directly, export these variables in your terminal.
# npm run dev manages an isolated local PostgreSQL cluster if DATABASE_URL is unset.
DATABASE_URL=postgres://gitown:change-this-local-development-password@127.0.0.1:55432/gitown?sslmode=disable
GITOWN_ADDR=127.0.0.1:8080
GITOWN_ORIGIN=http://localhost:3000
GITOWN_GIT_URL=http://localhost:8080/git
GITOWN_DATA_DIR=.data/repositories
